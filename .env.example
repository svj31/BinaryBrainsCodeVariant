# Public (safe to expose, prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com
# Optional: enable consent-gated, cookie-free analytics (Plausible)
NEXT_PUBLIC_ANALYTICS_DOMAIN=your-custom-domain.com

# Server only (never prefix with NEXT_PUBLIC_, never imported in client components)
CONTACT_WEBHOOK_URL=
